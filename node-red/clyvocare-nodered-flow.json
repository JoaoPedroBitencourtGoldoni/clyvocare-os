    {
        "id": "cd5a6c00a8cf5b04",
        "type": "inject",
        "z": "5d9c28597954a336",
        "name": "Dados do Pet — Demonstração IA",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": "0.1",
        "payload": "{\"dataReferencia\":\"2026-08-31\",\"perfil\":{\"id\":\"pet-001\",\"nome\":\"Thor\",\"especie\":\"cao\",\"idadeAnos\":3,\"faseVida\":\"adulto\"},\"historicoClinico\":[{\"data\":\"2026-03-10\",\"tipo\":\"consulta\",\"observacao\":\"acompanhamento de rotina\"}],\"vacinas\":[{\"nome\":\"Raiva\",\"proximaDose\":\"2026-08-15\",\"status\":\"atrasada\"},{\"nome\":\"V10\",\"proximaDose\":\"2027-01-10\",\"status\":\"em_dia\"}],\"consultas\":[{\"data\":\"2026-02-01\",\"tipo\":\"rotina\"}],\"medicamentos\":[{\"nome\":\"Tratamento prescrito\",\"status\":\"ativo\",\"retornoRecomendado\":true,\"dataRetorno\":\"2026-08-20\"}],\"comportamento\":{\"variacaoAtividadePercentual\":-35,\"origem\":\"PIR IoT + registro do tutor\"}}",
        "payloadType": "json",
        "x": 190,
        "y": 540,
        "wires": [
            [
                "18f63c81ad37d5a7"
            ]
        ]
    },
    {
        "id": "18f63c81ad37d5a7",
        "type": "function",
        "z": "5d9c28597954a336",
        "name": "Motor de Regras Inteligentes",
        "func": "// ClyvoCare OS — Sprint 3\n// Motor de regras inteligentes para recomendar e priorizar ações de cuidado.\n// A saída apoia tutor e clínica; não realiza diagnóstico veterinário.\n\nvar dados = msg.payload;\nvar pet = dados.perfil || {};\nvar referencia = new Date(dados.dataReferencia || new Date().toISOString().slice(0, 10));\nvar recomendacoes = [];\n\nfunction diasEntre(dataInicial, dataFinal) {\n    var inicio = new Date(dataInicial);\n    if (isNaN(inicio.getTime())) return 0;\n    return Math.floor((dataFinal - inicio) / (1000 * 60 * 60 * 24));\n}\n\nfunction prioridade(score) {\n    if (score >= 90) return 'ALTA';\n    if (score >= 60) return 'MEDIA';\n    return 'BAIXA';\n}\n\nfunction adicionar(servico, acao, score, motivo, origem) {\n    recomendacoes.push({\n        servico: servico,\n        acao: acao,\n        score: score,\n        prioridade: prioridade(score),\n        motivo: motivo,\n        dadosUtilizados: origem\n    });\n}\n\n// Regra 1 — Vacina atrasada: recomenda vacinação e prioriza pelo atraso.\n(dados.vacinas || []).forEach(function(vacina) {\n    var atraso = diasEntre(vacina.proximaDose, referencia);\n    if (vacina.status === 'atrasada' || atraso > 0) {\n        var scoreVacina = Math.min(100, 85 + Math.min(atraso, 30) / 2);\n        adicionar(\n            'Vacinação',\n            'Agendar reforço de ' + vacina.nome,\n            scoreVacina,\n            vacina.nome + ' está atrasada há ' + atraso + ' dia(s).',\n            ['vacinas', 'perfil']\n        );\n    }\n});\n\n// Regra 2 — Consulta preventiva personalizada pela fase de vida.\nvar intervaloConsulta = pet.faseVida === 'idoso' ? 120 : (pet.faseVida === 'filhote' ? 90 : 180);\nif ((dados.consultas || []).length > 0) {\n    var consultasOrdenadas = dados.consultas.slice().sort(function(a, b) {\n        return new Date(b.data) - new Date(a.data);\n    });\n    var diasSemConsulta = diasEntre(consultasOrdenadas[0].data, referencia);\n    if (diasSemConsulta > intervaloConsulta) {\n        adicionar(\n            'Consulta preventiva',\n            'Agendar consulta de rotina',\n            70,\n            'Pet ' + (pet.faseVida || 'sem fase informada') + ' está há ' + diasSemConsulta + ' dias sem consulta; referência usada: ' + intervaloConsulta + ' dias.',\n            ['perfil', 'consultas', 'historicoClinico']\n        );\n    }\n}\n\n// Regra 3 — Retorno associado a tratamento prescrito.\n(dados.medicamentos || []).forEach(function(med) {\n    if (med.status === 'ativo' && med.retornoRecomendado && med.dataRetorno) {\n        var atrasoRetorno = diasEntre(med.dataRetorno, referencia);\n        if (atrasoRetorno > 0) {\n            adicionar(\n                'Retorno clínico',\n                'Agendar retorno do tratamento em andamento',\n                90,\n                'Data de retorno registrada passou há ' + atrasoRetorno + ' dia(s).',\n                ['medicamentos', 'historicoClinico']\n            );\n        }\n    }\n});\n\n// Regra 4 — Mudança relevante de atividade observada pelo tutor/IoT.\nvar variacao = dados.comportamento && Number(dados.comportamento.variacaoAtividadePercentual);\nif (!isNaN(variacao) && variacao <= -30) {\n    adicionar(\n        'Avaliação veterinária',\n        'Sugerir avaliação por mudança de comportamento',\n        80,\n        'Atividade reduziu ' + Math.abs(variacao) + '% em relação ao padrão registrado.',\n        ['comportamento', 'perfil']\n    );\n}\n\n// Priorização final: maior score primeiro.\nrecomendacoes.sort(function(a, b) { return b.score - a.score; });\n\nmsg.payload = {\n    pet: { id: pet.id, nome: pet.nome, especie: pet.especie, faseVida: pet.faseVida },\n    abordagemIA: 'Motor de regras inteligentes',\n    estrategiaPersonalizacao: 'Regras ajustadas por fase de vida e contexto individual do pet',\n    totalRecomendacoes: recomendacoes.length,\n    recomendacoes: recomendacoes,\n    geradoEm: new Date().toISOString(),\n    aviso: 'As recomendações apoiam a decisão e não substituem avaliação veterinária.'\n};\nreturn msg;",
