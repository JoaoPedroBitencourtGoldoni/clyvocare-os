        "name": "Formata Msg WhatsApp",
        "func": "var alertas = msg.payload.alertas;\nvar mensagem = '🐾 *ClyvoCare OS* — Alerta de Vacinas\\n\\n';\n\nalertas.forEach(function(a) {\n    var emoji = a.situacao === 'ATRASADA' ? '🚨' : '⚠️';\n    mensagem += emoji + ' *' + a.pet + '* — ' + a.vacina + '\\n';\n    if (a.situacao === 'ATRASADA') {\n        mensagem += '   Atraso de ' + a.diasAtraso + ' dias. Agende agora!\\n';\n    } else {\n        mensagem += '   Vence em ' + a.diasRestantes + ' dias.\\n';\n    }\n    mensagem += '\\n';\n});\n\nmensagem += '📅 Agende: https://clyvocare.app/agendar';\nmsg.payload = mensagem;\nreturn msg;",
