    {
        "id": "47b8054d3e34723c",
        "type": "function",
        "z": "5d9c28597954a336",
        "name": "Checa Calendário Vacinal",
        "func": "var pets = [\n    {\n        nome: 'Thor',\n        especie: 'cachorro',\n        faseVida: 'adulto',\n        vacinas: [\n            { nome: 'Raiva', ultima: '2024-05-01', intervaloDias: 365 },\n            { nome: 'V10', ultima: '2025-01-10', intervaloDias: 365 },\n            { nome: 'Gripe Canina', ultima: '2025-03-05', intervaloDias: 365 }\n        ]\n    },\n    {\n        nome: 'Luna',\n        especie: 'gato',\n        faseVida: 'filhote',\n        vacinas: [\n            { nome: 'Tríplice Felina', ultima: '2025-04-01', intervaloDias: 30 }\n        ]\n    }\n];\n\nvar hoje = new Date();\nvar alertas = [];\n\npets.forEach(function(pet) {\n    pet.vacinas.forEach(function(vac) {\n        var ultimaData = new Date(vac.ultima);\n        var diasPassados = Math.floor((hoje - ultimaData) / (1000*60*60*24));\n        var diasRestantes = vac.intervaloDias - diasPassados;\n        if (diasRestantes <= 0) {\n            alertas.push({\n                pet: pet.nome,\n                vacina: vac.nome,\n                situacao: 'ATRASADA',\n                diasAtraso: Math.abs(diasRestantes),\n                faseVida: pet.faseVida\n            });\n        } else if (diasRestantes <= 30) {\n            alertas.push({\n                pet: pet.nome,\n                vacina: vac.nome,\n                situacao: 'VENCE_EM_BREVE',\n                diasRestantes: diasRestantes,\n                faseVida: pet.faseVida\n            });\n        }\n    });\n});\n\nmsg.payload = { alertas: alertas, total: alertas.length, checkedAt: hoje.toISOString() };\nreturn msg;",
        "outputs": 1,
        "x": 510,
        "y": 440,
        "wires": [
            [
                "77db7405d13bcbc4",
                "1ff611660d32e30d"
            ]
        ]
    },
