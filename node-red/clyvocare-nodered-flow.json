    {
        "id": "451f546aba1ba63a",
        "type": "function",
        "z": "9b732deb6dd27115",
        "name": "Processa Temperatura",
        "func": "var temp = parseFloat(msg.payload);\n\nif (isNaN(temp)) return null;\n\n// Verifica alerta\nif (temp > 39.2 || (temp < 37.5 && temp > 20)) {\n    var alertMsg = { payload: {\n        sensor: 'temperatura',\n        valor: temp,\n        status: temp > 39.2 ? 'febre' : 'hipotermia',\n        pet: 'Thor',\n        timestamp: new Date().toISOString()\n    }};\n    node.send([{ payload: temp }, alertMsg]);\n} else {\n    node.send([{ payload: temp }, null]);\n}",
        "outputs": 2,
        "x": 380,
        "y": 80,
        "wires": [
            [
                "ce698ce9e8c599dc",
                "b77233f8737f984a"
            ],
