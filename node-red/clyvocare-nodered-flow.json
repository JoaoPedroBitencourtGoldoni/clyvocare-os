    {
        "id": "1f7b42dae4efa092",
        "type": "function",
        "z": "9b732deb6dd27115",
        "name": "Calcula Risco Regional",
        "func": "var regioes = [\n    { nome: 'Zona Norte', risco: 'ALTO', doencas: ['Leishmaniose', 'Dengue Canina'], petsAfetados: 8 },\n    { nome: 'Zona Sul', risco: 'MEDIO', doencas: ['Parvovirose'], petsAfetados: 3 },\n    { nome: 'Zona Leste', risco: 'BAIXO', doencas: [], petsAfetados: 0 },\n    { nome: 'Zona Oeste', risco: 'MEDIO', doencas: ['Cinomose'], petsAfetados: 2 },\n    { nome: 'Centro', risco: 'BAIXO', doencas: [], petsAfetados: 0 },\n    { nome: 'ABC', risco: 'ALTO', doencas: ['Leishmaniose'], petsAfetados: 5 }\n];\nvar regioesAltas = regioes.filter(function(r) { return r.risco === 'ALTO'; });\nmsg.payload = JSON.stringify({\n    analise: regioes,\n    alertasAltos: regioesAltas.length,\n    totalPetsEmRisco: regioesAltas.reduce(function(acc, r) { return acc + r.petsAfetados; }, 0),\n    geradoEm: new Date().toISOString()\n});\nreturn msg;",
